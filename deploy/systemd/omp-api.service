# /etc/systemd/system/omp-api.service
[Unit]
Description=Orlin Monnar Photography API
After=network.target

[Service]
WorkingDirectory=/var/www/omp/api
ExecStart=/usr/bin/dotnet /var/www/omp/api/omp-api.dll
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=omp-api
User=omp
EnvironmentFile=/etc/omp/omp-api.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5000
Environment=DOTNET_NOLOGO=true

[Install]
WantedBy=multi-user.target
