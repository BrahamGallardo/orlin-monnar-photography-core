# /etc/omp/omp-api.env   (root:omp, chmod 640)
# Plantilla sin secretos. Copiar al servidor y completar; NUNCA versionar el archivo real.
# Separador de sección: __ (doble guion bajo). Ver la tabla "Producción" del README.
ConnectionStrings__DefaultConnection=
BrahmCQRS__Auth__JWT__SecretKey=
Mail__SmtpServer=
Mail__SmtpPort=587
Mail__SenderEmail=
Mail__SenderPassword=
ReCaptcha__SecretKey=
Storage__RootPath=/var/omp/media
Storage__PublicBaseUrl=/media
# Debe ser igual a client_max_body_size de Nginx y a storage.maxUploadSizeMb del panel.
Storage__MaxUploadSizeMB=25
ContactUs__RecipientEmail=
Booking__RecipientEmail=
# ForwardedHeaders__KnownProxies__0 se omite: Nginx corre en loopback (confiado por defecto).
