<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>omp_api</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.JsonPatch" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\omp-domain\omp-domain.csproj" />
    <ProjectReference Include="..\omp-application\omp-application.csproj" />
    <ProjectReference Include="..\omp-infrastructure\omp-infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BrahmCQRS.Domain">
      <HintPath>..\libs\BrahmCQRS.Domain.dll</HintPath>
    </Reference>
    <Reference Include="BrahmCQRS.Application">
      <HintPath>..\libs\BrahmCQRS.Application.dll</HintPath>
    </Reference>
    <Reference Include="BrahmCQRS.Infrastructure">
      <HintPath>..\libs\BrahmCQRS.Infrastructure.dll</HintPath>
    </Reference>
    <Reference Include="BrahmCQRS.Shared">
      <HintPath>..\libs\BrahmCQRS.Shared.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
